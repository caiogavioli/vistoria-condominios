{
  "name": "vistoria-condominios",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App de vistorias de condomínios: checklist por área, fotos, notas e geração do relatório em PDF.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:servidor": "tsx scripts/test-servidor.ts",
    "typecheck:api": "tsc -p tsconfig.api.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dexie": "^4.4.0",
    "dexie-react-hooks": "^4.2.0",
    "jose": "^6.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "^5.9.9",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
